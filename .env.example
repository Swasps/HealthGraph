# Application
APP_NAME=HealthGraph
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-value

# Database
POSTGRES_USER=healthgraph
POSTGRES_PASSWORD=healthgraph
POSTGRES_DB=healthgraph
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://healthgraph:healthgraph@localhost:5432/healthgraph
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL_SECONDS=60

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# GraphQL
GRAPHQL_MAX_QUERY_DEPTH=10
GRAPHQL_MAX_QUERY_COMPLEXITY=1000
